rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(id) {
      return signedIn() && get(/databases/$(database)/documents/visit_owners/$(id)).data.uid == request.auth.uid;
    }
    function validMountain(id) {
      return id is string && (id in [
        'myeongseong', 'baegun', 'hwaak', 'gamaksan', 'soyo', 'unak', 'myeongji',
        'mani', 'bukhansan', 'dobongsan', 'chukryeong', 'cheonma', 'gwanak', 'yumyeong', 'yongmun'
      ] || id.matches('national-(00[1-9]|0[1-7][0-9]|08[0-5])'));
    }
    function validDate(value) {
      let parts = value.split('-');
      let date = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      return value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && date.year() == int(parts[0]) && date.month() == int(parts[1]) && date.day() == int(parts[2])
        && date <= (request.time + duration.value(9, 'h')).date();
    }
    function validVisit(data) {
      return data.keys().hasAll(['mountain_id', 'visited_on', 'author', 'comment'])
        && data.keys().hasOnly(['mountain_id', 'visited_on', 'author', 'comment'])
        && validMountain(data.mountain_id)
        && data.visited_on is string && validDate(data.visited_on)
        && data.author is string && data.author.trim().size() > 0 && data.author.size() <= 40
        && data.comment is string && data.comment.trim().size() > 0 && data.comment.size() <= 2000;
    }

    match /mountain_visits/{id} {
      allow read: if true;
      // The public record and private owner must be created in one atomic batch.
      allow create: if signedIn() && validVisit(request.resource.data)
        && !exists(/databases/$(database)/documents/visit_owners/$(id))
        && getAfter(/databases/$(database)/documents/visit_owners/$(id)).data.uid == request.auth.uid;
      allow update: if owner(id) && validVisit(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visited_on', 'author', 'comment']);
      allow delete: if owner(id)
        && !existsAfter(/databases/$(database)/documents/visit_owners/$(id));
    }
    match /visit_owners/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/mountain_visits/$(id))
        && existsAfter(/databases/$(database)/documents/mountain_visits/$(id));
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/mountain_visits/$(id));
    }
  }
}
